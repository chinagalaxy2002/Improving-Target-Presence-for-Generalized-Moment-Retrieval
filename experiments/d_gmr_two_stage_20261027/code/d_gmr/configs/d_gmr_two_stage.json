{
  "method": "D-GMR-TwoStage",
  "seed": 2026,
  "initialization_protocol": "strict native GMR checkpoint; pre-trained decoupled GEQ (Stage 1) initialized and frozen; seed-2026 TEM and TECR; two-tier decoupled ranking loss and plurality-aware temporal selection",
  "top_k": 10,
  "hidden_dim": 256,
  "relation_layers": 1,
  "dropout": 0.1,
  "epochs": 4,
  "optimizer": "AdamW",
  "learning_rates": {
    "native_gmr": 1e-05,
    "geq": 0.0,
    "tem_tecr": 0.0001
  },
  "weight_decay": 0.0001,
  "grad_clip_norm": 0.1,
  "scheduler": "constant",
  "freeze_native_gmr": false,
  "freeze_geq": true,
  "two_stage_geq_init": true,
  "stage1_geq_checkpoints": {
    "moment_detr": "stage1/runs/moment_detr/E1/epoch_004.ckpt",
    "qd_detr": "stage1/runs/qd_detr/E1/epoch_004.ckpt",
    "cg_detr": "stage1/runs/cg_detr/E1/epoch_004.ckpt",
    "eatr": "stage1/runs/eatr/E1/epoch_004.ckpt",
    "flashvtg": "stage1/runs/flashvtg/E1/epoch_004.ckpt"
  },
  "enable_temporal_evidence": true,
  "enable_competition": true,
  "enable_cooperation": true,
  "enable_quality_ranking": true,
  "enable_pat_select": true,
  "pat_sigma": {
    "moment_detr": 0.5,
    "qd_detr": 0.5,
    "cg_detr": 1.0,
    "eatr": 1.0,
    "flashvtg": 2.0
  },
  "pat_iou_thresh": {
    "moment_detr": 0.2,
    "qd_detr": 0.3,
    "cg_detr": 0.4,
    "eatr": 0.2,
    "flashvtg": 0.3
  },
  "batch_sizes": {
    "moment_detr": 8,
    "qd_detr": 32,
    "cg_detr": 32,
    "eatr": 32,
    "flashvtg": 8
  },
  "micro_batch_sizes": {
    "moment_detr": 8,
    "qd_detr": 32,
    "cg_detr": 32,
    "eatr": 32,
    "flashvtg": 8
  },
  "loss_weights": {
    "native": 1.0,
    "presence": 0.0,
    "quality": 1.0,
    "intra_ranking": 1.0,
    "inter_ranking": 0.5,
    "set": 0.5,
    "evidence": 0.5
  },
  "ranking_epsilon": 0.1,
  "intra_margin": 0.15,
  "inter_margin": 0.15,
  "coverage_iou_threshold": 0.5,
  "neighborhood_extension": 0.5,
  "evidence_positive_weight": 1.0,
  "residual_scale": 1.0,
  "presence_threshold": 0.4,
  "selection": "Val mAP descending, Val mR@1 descending, epoch ascending",
  "formal_test": "once per backbone, only after all four Val results and selection are saved",
  "amp": false,
  "workers": 0,
  "gpu_slots_per_device": 2,
  "detach_geq_event_for_tem": true
}
