{
  "description": "Two-component factorial ablation: Global Event Query and hard rectangular RoI; no LoRA, Gaussian, saliency or fusion",
  "use_moment_conditioning": true,
  "use_global_branch": true,
  "use_boundary_refine": true,
  "refine_max_delta": 1.5,
  "refine_iou_conf": true,
  "refine_giou": true,
  "refine_weight": 0.5,
  "gradient_attached": true,
  "use_lora": false,
  "lora_rank": 8,
  "evidence_gate": false,
  "evidence_thresh": 0.1,
  "evidence_scale": 1.5,
  "logit_bias": 0.0,
  "balanced_safeguard": false,
  "tau_neg": 0.25,
  "tau_pos": 0.7,
  "pos_safeguard_weight": 2.5,
  "neg_safeguard_weight": 2.5,
  "selection_metric": "fixed epoch 4; no test selection",
  "hard_negative": false,
  "lr": 3e-05,
  "wd": 0.0001,
  "grad_clip": 0.1,
  "epochs": 4,
  "lr_drop": 8,
  "seed": 2026,
  "multi_weight": 0.0,
  "top_k": 8,
  "pooling_type": "uniform_box",
  "presence_source": "global_refine",
  "init_protocol": "correct_init_v1",
  "materialize_common_modules": true,
  "run_id": "global_hard_roi",
  "augmentation": false,
  "qcd": false,
  "query_swap": false,
  "background_replacement": false,
  "synthetic_negatives": false,
  "synthetic_samples": false,
  "full_training_authorized": true,
  "batch_size_policy": "native baseline batch size",
  "num_workers": 0,
  "test_used": false,
  "checkpoint_selection": "fixed epoch 4",
  "evaluation_split": "val then test after training",
  "use_saliency_6d": false,
  "candidate_presence_fusion": false,
  "test_used_for_selection": false
}
