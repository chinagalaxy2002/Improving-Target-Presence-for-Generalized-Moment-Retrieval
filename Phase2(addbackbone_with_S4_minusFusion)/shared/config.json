  "test_used": false,
  "evaluation_start_epoch": 3,
  "plot_start_epoch": 3,
  "save_every_epoch": true,
  "test_evaluation": "epoch3-6 frozen-checkpoint diagnostic curves only; never checkpoint or threshold selection",
  "checkpoint_selection": "none",
  "evaluation_split": "test"
